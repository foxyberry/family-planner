module(
    name = "family_planner",
    version = "0.1.0",
)

# The apple_support bazel_dep must come before rules_cc.
# https://github.com/bazelbuild/apple_support#incompatible-toolchain-resolution
bazel_dep(
    name = "apple_support",
    version = "1.24.5",
    repo_name = "build_bazel_apple_support",
)
bazel_dep(
    name = "rules_swift",
    version = "3.6.0",
    repo_name = "build_bazel_rules_swift",
)
bazel_dep(
    name = "rules_apple",
    version = "4.3.3",
    repo_name = "build_bazel_rules_apple",
)
bazel_dep(name = "bazel_skylib", version = "1.9.0")
# >= 1.19.0 compiles each Swift package with its own minimum OS (rules_swift_package_manager#892).
# Older versions compiled TCA's dependencies with the app's iOS 26 minimum, which broke
# swift-perception's back-ported APIs that are marked obsoleted after iOS 17.
bazel_dep(name = "rules_swift_package_manager", version = "1.25.0")

bazel_dep(
    name = "rules_xcodeproj",
    version = "3.5.1",
    dev_dependency = True,
)

# Apple CC toolchain
apple_cc_configure = use_extension(
    "@build_bazel_apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

# Swift Package Manager dependencies (declared in Package.swift)
swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_package",
    "swiftpkg_swift_composable_architecture",
)
