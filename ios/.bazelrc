# iOS-specific Bazel configuration.
# Used by Makefile iOS commands and imported by xcodeproj.bazelrc for Xcode builds.

build --apple_platform_type=ios
build --features=swift.use_global_module_cache
build --features=swift.cacheable_swiftmodules
build --features=swift.vfsoverlay
build --features=-swift.index_while_building_v2

# Simulator tests run one target at a time: parallel targets fight over the simulator and
# time out on small CI runners (and an 8 GB Mac has room for one simulator anyway).
test --local_test_jobs=1

# A signed build for a real iPad (`make device`).
build:device --ios_multi_cpus=arm64
build:device --define=fp_device=1
