load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("//:project.bzl", "BUNDLE_ID", "MINIMUM_OS_VERSION")
load("//ios:build_defs.bzl", "fp_swift_library")

# User journeys through the root store (Reflex style: send an action, assert State), one test per
# journey. The outside world is faked through dependencies only (World.swift). In `make test`.
fp_swift_library(
    name = "JourneysLib",
    testonly = True,
    deps = [
        "//ios/AppCore",
        "//ios/Clients/AppSettings",
        "//ios/Clients/BusClient",
        "//ios/Clients/HolidayProvider",
        "//ios/Clients/ParentAuthClient",
        "//ios/Clients/ScheduleStore",
        "//ios/Clients/SchoolDirectory",
        "//ios/Domain",
        "//ios/Features/Grownup",
        "//ios/Features/Home",
        "//ios/Features/Setup",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

ios_unit_test(
    name = "Journeys",
    bundle_id = BUNDLE_ID + ".journeys.tests",
    minimum_os_version = MINIMUM_OS_VERSION,
    runner = "//ios:test_runner",
    deps = [":JourneysLib"],
)
