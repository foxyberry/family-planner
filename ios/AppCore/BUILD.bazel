load("//ios:build_defs.bzl", "fp_swift_library")

# Screens, state and lifecycle of the app. Depends on Clients *interfaces* only;
# the app target (//ios:FamilyPlannerApp) injects the Live implementations.
fp_swift_library(
    name = "AppCore",
    visibility = ["//ios:__subpackages__"],
    deps = [
        "//ios/Clients/ParentAuthClient",
        "//ios/DebugTools",
        "//ios/DesignSystem",
        "//ios/Domain",
        "//ios/Features/Grownup",
        "//ios/Features/Home",
        "//ios/Features/Missions",
        "//ios/KitArt",
        "//ios/Strings",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)
