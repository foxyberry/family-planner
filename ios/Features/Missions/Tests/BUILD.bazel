load("@build_bazel_rules_apple//apple:ios.bzl", "ios_unit_test")
load("//:project.bzl", "BUNDLE_ID", "MINIMUM_OS_VERSION")
load("//ios:build_defs.bzl", "fp_swift_library")

fp_swift_library(
    name = "MissionsTestsLib",
    testonly = True,
    deps = [
        "//ios/Clients/AppSettings",
        "//ios/Clients/HolidayProvider",
        "//ios/Clients/ScheduleStore",
        "//ios/DesignSystem",
        "//ios/Domain",
        "//ios/Features/Missions",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

ios_unit_test(
    name = "MissionsTests",
    bundle_id = BUNDLE_ID + ".missions.tests",
    minimum_os_version = MINIMUM_OS_VERSION,
    runner = "//ios:test_runner",
    deps = [":MissionsTestsLib"],
)
