load("@build_bazel_rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("//:project.bzl", "BUNDLE_ID")
load("//ios:build_defs.bzl", "fp_swift_library")

# MOE schools (data.gov.sg, OneMap) and the international and private schools (see Resources/SOURCE.md).
apple_resource_bundle(
    name = "SchoolDirectoryResources",
    bundle_id = BUNDLE_ID + ".schools",
    infoplists = ["ResourceBundle-Info.plist"],
    resources = glob(["Resources/*.json"]),
)

# Schools that are on this family's private-terms list stay on this machine only (git-ignored),
# in the same shape; clones and CI build without them.
apple_resource_bundle(
    name = "SchoolDirectoryLocalResources",
    bundle_id = BUNDLE_ID + ".schools.local",
    infoplists = ["ResourceBundle-Info.plist"],
    resources = glob(
        ["Private/*.json"],
        allow_empty = True,
    ),
)

fp_swift_library(
    name = "SchoolDirectoryLive",
    data = [
        ":SchoolDirectoryLocalResources",
        ":SchoolDirectoryResources",
    ],
    visibility = [
        "//ios:__pkg__",
        "//ios/Clients/SchoolDirectoryLive/Tests:__pkg__",
    ],
    deps = [
        "//ios/Clients/SchoolDirectory",
        "//ios/Domain",
    ],
)
