# Shared Bazel settings for every part of this monorepo.
# Platform-specific flags live next to the code (ios/.bazelrc); machine-specific
# limits live in the git-ignored user.bazelrc (see user.bazelrc.example).

common --enable_bzlmod

# Local caches shared across projects on this machine.
common --disk_cache=~/.cache/bazel-disk
common --experimental_disk_cache_gc_max_size=10G
common --repository_cache=~/.cache/bazel-repo

# Only show test logs for failures.
test --test_output=errors

try-import %workspace%/user.bazelrc
